# Local development values only. Replace them before using this stack outside a
# private development machine. Compose also has safe local-only fallbacks.

POSTGRES_USER=fraud_dev
POSTGRES_PASSWORD=local-dev-fraud-password-change-me
POSTGRES_DB=fraud
POSTGRES_PORT=5432

MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

AUTH_ENABLED=false
DEV_AUTH_ROLE=ADMIN

FRONTEND_PORT=8080
BACKEND_PORT=8000
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

DRIFT_PSI_WARNING=0.10
DRIFT_PSI_CRITICAL=0.25
DRIFT_RETRAINING_RECOMMENDATION_POLICY=warning
GRAPH_BACKEND=networkx

# Optional profile credentials/configuration. These are placeholders only.
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-neo4j-password-change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OLLAMA_PORT=11434

# Optional OIDC settings; do not put client secrets in frontend config.
# AUTH_ENABLED=true
# OIDC_ISSUER=https://identity.example.invalid/
# OIDC_AUDIENCE=fraud-platform
# OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
